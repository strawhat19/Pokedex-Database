# Web uses the current site origin. Native development requires the reachable Expo
# server origin; use your computer's LAN address rather than localhost on a phone.
EXPO_PUBLIC_API_ORIGIN=

# Optional server-only API access key. Never use an EXPO_PUBLIC_ variable for this
# secret. Enabling it requires a server-side proxy for the public frontend.
API_KEY=

# Optional additional browser origins, comma separated; no wildcard by default.
API_ALLOWED_ORIGINS=

# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
API_TRUST_PROXY=false
