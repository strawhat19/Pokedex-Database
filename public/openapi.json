  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Optional server-only API_KEY setting enables this requirement on v1 resources. Do not embed a private key in EXPO_PUBLIC_ variables or client bundles. A public frontend then requires an authenticated server-side proxy. RapidAPI gateway credentials, billing, quota enforcement and shared rate limiting are not implemented."
      }
    },
    "schemas": {
      "Artwork": {
        "type": "object",
        "required": [
          "default",
          "shiny",
          "sprite",
          "shinySprite"
        ],
        "properties": {
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "shiny": {
            "type": [
              "string",
              "null"
            ]
          },
          "sprite": {
            "type": [
              "string",
              "null"
            ]
          },
          "shinySprite": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Stat": {
        "type": "object",
        "required": [
          "name",
          "value",
          "effort"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "integer"
          },
          "effort": {
            "type": "integer"
          }
        }
      },
      "Ability": {
        "type": "object",
        "required": [
          "name",
          "slot",
          "isHidden"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "slot": {
            "type": "integer"
          },
          "isHidden": {
            "type": "boolean"
          }
        }
      },
      "Description": {
        "type": "object",
        "required": [
          "text",
          "version",
          "language"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "language": {
            "const": "en"
          }
        }
      },
      "PokemonCard": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "displayName",
          "description",
          "weightKg",
          "heightMeters",
          "generation",
          "types",
          "artwork",
          "stats",
          "abilities",
          "descriptions",
          "baseExperience"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 493
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "weightKg": {
            "type": "number"
          },
          "heightMeters": {
            "type": "number"
          },
          "generation": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "bug",
                "dark",
                "ice",
                "fire",
                "rock",
                "fairy",
                "ghost",
                "grass",
                "steel",
                "water",
                "dragon",
                "flying",
                "ground",
                "normal",
                "poison",
                "psychic",
                "electric",
                "fighting"
              ]
            }
          },
          "artwork": {
            "$ref": "#/components/schemas/Artwork"
          },
          "stats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Stat"
            }
          },
          "abilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ability"
            }
          },
          "descriptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Description"
            }
          },
          "baseExperience": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "PokemonDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PokemonCard"
          },
          {
            "type": "object",
            "required": [
              "habitat",
              "isBaby",
              "isMythical",
              "isLegendary",
              "genderRate",
              "captureRate",
              "baseHappiness",
              "growthRate",
              "eggGroups",
              "evolutions"
            ],
            "properties": {
              "habitat": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "isBaby": {
                "type": "boolean"
              },
              "isMythical": {
                "type": "boolean"
              },
              "isLegendary": {
                "type": "boolean"
              },
              "genderRate": {
                "type": "integer"
              },
              "captureRate": {
                "type": "integer"
              },
              "baseHappiness": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "growthRate": {
                "type": "string"
              },
              "eggGroups": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evolutions": {
                "$ref": "#/components/schemas/Evolution"
              }
            }
          }
        ]
      },
      "EvolutionMethod": {
        "type": "object",
        "required": [
          "method",
          "trigger",
          "conditions",
          "versionGroup",
          "raw"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versionGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw": {
            "type": "object",
            "additionalProperties": true,
            "description": "Unmodified PokéAPI evolution_detail object, including all item, level, friendship, beauty, location, gender, move, party, trade, time and version constraints supplied upstream"
          }
        }
      },
      "EvolutionNode": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isBaby",
          "displayName",
          "evolvesFrom",
          "evolvesTo"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "isBaby": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "evolvesFrom": {
            "type": [
              "integer",
              "null"
            ]
          },
          "evolvesTo": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "EvolutionEdge": {
        "type": "object",
        "required": [
          "to",
          "from",
          "methods"
        ],
        "properties": {
          "to": {
            "type": "integer"
          },
          "from": {
            "type": "integer"
          },
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvolutionMethod"
            }
          }
        }
      },
      "Evolution": {
        "type": "object",
        "required": [
          "id",
          "nodes",
          "edges",
          "babyTriggerItem",
          "scope",
          "note"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvolutionNode"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvolutionEdge"
            }
          },
          "babyTriggerItem": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "const": "generations-1-4"
          },
          "note": {
            "type": "string",
            "description": "Version caveat: versioned methods are restricted through HeartGold/SoulSilver; unversioned methods and special triggers can need game-specific steps not supplied by PokéAPI."
          }
        }
