              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "requestId",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string"
                    },
