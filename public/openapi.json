    "/api/v1/pokemon": {
      "get": {
        "tags": [
          "Pokémon"
        ],
        "operationId": "listPokemon",
        "summary": "List complete Pokémon entry cards",
        "description": "Results are ordered by National Pokédex number. Search accepts a partial species name or exact numerical ID. Type filtering reflects current PokéAPI typing. On an upstream failure the request fails honestly; partial pages are not silently returned.",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string",
              "maxLength": 80
            },
            "description": "Partial species name or exact National Pokédex number, e.g. pikachu, 025 or #025. Decimal and signed values are not converted to IDs."
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "bug",
                "dark",
                "ice",
                "fire",
                "rock",
                "fairy",
                "ghost",
                "grass",
                "steel",
                "water",
                "dragon",
                "flying",
                "ground",
                "normal",
                "poison",
                "psychic",
                "electric",
                "fighting"
              ],
              "default": "all"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 493,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "generation",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "1",
                "2",
                "3",
                "4"
              ],
              "default": "all"
            }
          },
          {
            "in": "query",
            "name": "shiny",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Presentation preference echoed in filters. Both standard and shiny artwork are returned for every card; this does not filter species."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "requestId",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PokemonCard"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Configured API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not found or outside generations 1–4",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Per-process rate limit exceeded. Observe Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "Upstream unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Bounded upstream queue is full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "default": {
            "description": "The request could not be completed. The status and error code identify the failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemon/{id}": {
