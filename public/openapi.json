{
  "openapi": "3.1.0",
  "info": {
    "title": "Pokedex Database API",
    "version": "1.0.0",
    "description": "A normalized, read-only API for National Pokédex species #001–493. Live data is fetched server-side from PokéAPI, cached for six hours, and never substituted with fabricated records. English flavor text is limited to generation 1–4 games. Current PokéAPI types, abilities and stats are returned. Trainer accounts, votes and teams are local app services, not public HTTP resources. Server deployment and commercial asset/data permissions must be resolved before a marketplace release."
  },
  "servers": [
    {
      "url": "/",
      "description": "The deployed app server; native clients configure EXPO_PUBLIC_API_ORIGIN"
    }
  ],
  "security": [
    {},
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Directory"
    },
    {
      "name": "Pokémon"
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "tags": [
          "Directory"
        ],
        "security": [],
        "operationId": "getDirectory",
        "summary": "API directory and connection metadata",
        "responses": {
          "200": {
            "description": "Directory",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "requestId",
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "requestId": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Directory"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Per-process rate limit exceeded. Observe Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "default": {
            "description": "The request could not be completed. The status and error code identify the failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
